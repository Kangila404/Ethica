// Copy to Local.xcconfig. For a physical iPhone, use the Mac's LAN address.
// Simulator uses localhost:3000 by default. Override with launch environment ETHICA_API_URL.
ETHICA_API_BASE_URL = http:/$()/192.168.1.100:3000/api/
GOOGLE_IOS_CLIENT_ID = YOUR_IOS_CLIENT_ID.apps.googleusercontent.com
GOOGLE_SERVER_CLIENT_ID = YOUR_WEB_CLIENT_ID.apps.googleusercontent.com
GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.YOUR_IOS_CLIENT_ID
KAKAO_NATIVE_APP_KEY = YOUR_NATIVE_APP_KEY
DEVELOPMENT_TEAM = YOUR_TEAM_ID
// Optional HTTPS base for imageKey values stored as relative paths.
ETHICA_MEDIA_BASE_URL =
