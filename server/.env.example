PORT=

DB_HOST=
DB_PORT=
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=

JWT_SECRET=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Comma-separated exact ID-token audiences; blank disables that provider.
# Google OAuth client IDs used by the iOS/OIDC client.
GOOGLE_CLIENT_IDS=
# Native Sign in with Apple: Bundle ID. Web flow: Services ID.
APPLE_CLIENT_IDS=
# Kakao OIDC enabled app: app key used by the selected SDK/REST flow.
KAKAO_CLIENT_IDS=

# Production always disables schema synchronization.
DB_SYNCHRONIZE=false
