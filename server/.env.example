PORT=

DB_HOST=
DB_PORT=
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=

JWT_SECRET=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Comma-separated exact ID-token audiences; blank disables that provider.
# Google OAuth client IDs used by the iOS/OIDC client.
GOOGLE_CLIENT_IDS=
# Native Sign in with Apple: Bundle ID. Web flow: Services ID.
APPLE_CLIENT_IDS=
# Kakao OIDC enabled app: app key used by the selected SDK/REST flow.
KAKAO_CLIENT_IDS=

# Production always disables schema synchronization.
DB_SYNCHRONIZE=false

# Account withdrawal and encrypted revocation retries (never commit real values)
# Generate a 32-byte random key encoded as 64 hex characters; retain until all jobs finish.
SOCIAL_TOKEN_ENCRYPTION_KEY=
APPLE_REVOCATION_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
KAKAO_APP_ID=
KAKAO_ADMIN_KEY=

# Persistent image storage (TrueNAS: mount the media dataset at /data/media)
# Uploaded images are not committed. Curated assets ship with the server.
MEDIA_UPLOAD_DIRECTORY=media-uploads
MEDIA_CONTENT_DIRECTORY=content-media
