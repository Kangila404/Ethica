# Copy to the NAS stack's .env. Keep server secrets in server.env (raw KEY=value).
SERVER_IMAGE=your-dockerhub-account/ethica-server:commit-sha
API_BIND_ADDRESS=127.0.0.1
API_PORT=30002
PROXY_NETWORK=proxy
ETHICA_DATA_DIR=/mnt/YOUR_POOL/apps/ethica
ETHICA_BACKUP_DIR=/mnt/YOUR_POOL/backups/ethica
MYSQL_DATABASE=ethica
MYSQL_USER=ethica
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
